# Databricks Configuration
DATABRICKS_HOST=https://dbc-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_token_here
DATABRICKS_CLUSTER_ID=optional-cluster-id

# SonarQube Configuration
SONAR_TOKEN=your_sonarqube_token_here

# Jenkins Configuration
JENKINS_ADMIN_PASSWORD=admin

# Fortify Configuration (optional - requires license)
FORTIFY_SSC_URL=https://fortify-ssc.example.com
FORTIFY_SSC_TOKEN=your_fortify_token_here
RUN_FORTIFY=false

# Unity Catalog Data Paths
UC_DATA_PATH=/Volumes/workspace/esteira/data/cars.csv
UC_MODEL_PATH=/Volumes/workspace/esteira/data/models
